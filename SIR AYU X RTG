--------------------------------------------------
-- FIXED HYBRID ADMIN ENGINE INTERACTION ROUTINES
--------------------------------------------------
local MasterId = player.UserId
local Admins = {}

local function DoCmd(msg, p)
    if not p then return end
    if p.UserId ~= MasterId and not Admins[p.UserId] then return end
    
    -- Strip away the giant bypass prefix sequence of @ characters and clean whitespace
    msg = msg:gsub("^@+", "")
    msg = msg:match("^%s*(.-)%s*$")

    local pts = string.split(msg, " ")
    local cmd = string.lower(pts[1] or "")
    local arg = pts[2]
    local t = nil
    
    if arg then
        for _, pl in pairs(Players:GetPlayers()) do 
            if string.find(string.lower(pl.Name), string.lower(arg)) or string.find(string.lower(pl.DisplayName), string.lower(arg)) then 
                t = pl
                break 
            end 
        end
    end
    
    if cmd == "!start" then 
        saying = true 
    elseif cmd == "!stop" then 
        saying = false
    elseif cmd == "!exit" then
        saying = false
        gui:Destroy()
    elseif cmd == "!text" then 
        if arg then targetName = arg end
    elseif cmd == "!speed" and p.Character then 
        local hum = p.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = tonumber(arg) or 16 end
    elseif cmd == "!freset" and t and t.Character then 
        t.Character:BreakJoints() 
    elseif cmd == "!tpto" and t and t.Character and p.Character then 
        local tRoot = t.Character:FindFirstChild("HumanoidRootPart")
        local pRoot = p.Character:FindFirstChild("HumanoidRootPart")
        if tRoot and pRoot then tRoot.CFrame = pRoot.CFrame end
    elseif cmd == "!tp" and t and t.Character and p.Character then 
        local tRoot = t.Character:FindFirstChild("HumanoidRootPart")
        local pRoot = p.Character:FindFirstChild("HumanoidRootPart")
        if tRoot and pRoot then pRoot.CFrame = tRoot.CFrame end
    elseif cmd == "!kick" and t then 
        t:Kick("Kicked via Control Hub Engine Process") 
    elseif cmd == "!cmd" and p.UserId == MasterId and t then 
        Admins[t.UserId] = true 
    elseif cmd == "!uncmd" and p.UserId == MasterId and t then 
        Admins[t.UserId] = nil 
    end
end

-- Universal Multi-Generation Hook Architecture
if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
    TextChatService.MessageReceived:Connect(function(textResult)
        local textSource = textResult.TextSource
        if textSource then
            local p = Players:GetPlayerByUserId(textSource.UserId)
            if p then DoCmd(textResult.Text, p) end
        end
    end)
end

