--------------------------------------------------
-- UNIVERSAL SECURE CHAT SEND ENGINE
--------------------------------------------------
local function SecureSend(m) 
    pcall(function() 
        local combinedMessage = AtPrefix .. " " .. m 
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then 
            local tc = TextChatService:FindFirstChild("TextChannels")
            local genChannel = tc and tc:FindFirstChild("RBXGeneral")
            if genChannel then
                genChannel:SendAsync(combinedMessage)
            else
                local sayReq = RS:FindFirstChild("SayMessageRequest", true) or RS:FindFirstChild("DefaultChatSystemChatEvents") and RS.DefaultChatSystemChatEvents:FindFirstChild("SayMessageRequest")
                if sayReq then sayReq:FireServer(combinedMessage, "All") end
            end
        else 
            local sayReq = RS:FindFirstChild("SayMessageRequest", true) or RS:FindFirstChild("DefaultChatSystemChatEvents") and RS.DefaultChatSystemChatEvents:FindFirstChild("SayMessageRequest")
            if sayReq then sayReq:FireServer(combinedMessage, "All") end
        end 
    end) 
end

